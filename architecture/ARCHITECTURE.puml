@startuml MLRC-ACCS-ARCHITECTURE
title MLRC ACCS — current implementation architecture
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam wrapWidth 190

package "Flutter application (screen_mirror)" {
  class WatcherTerminalApp <<StatelessWidget>>
  class TerminalDashboard <<StatefulWidget>>
  class "_TerminalDashboardState" as DashboardState <<State>> {
    - _activeMode: String
    - _isStreaming: bool
    - _commType: String
    - _logs: List<String>
    + _toggleWatcher(mode): Future<void>
    + _captureScreen(): Future<void>
    + _toggleDeviceDiscovery(): Future<void>
    - _pollReceivedFrame(transport): void
  }
  class ScreenCaptureService {
    + captureCurrentScreen(): Future<Uint8List>
    - _captureAndroidScreen(): Future<Uint8List>
  }
  class LocalPeerDiscovery {
    + port: int
    + start(): Future<void>
    + stop(): Future<void>
    - _handleDiscoveryEvent(event): void
    - _resolveService(service): Future<void>
  }
  class "ADB discovery helpers" as AdbDiscovery {
    + findAdbDevices(): Future<List<AdbDevice>>
    + parseAdbDevices(output): List<AdbDevice>
  }
  class DiscoveredNode
  class AdbDevice
  class "TCP presence ServerSocket" as PresenceServer
  class RustTransport {
    + start(mode, localPort, peerAddress, peerPort): void
    + sendFrame(frame): void
    + pollFrame(): Uint8List?
    + stop(): void
  }
}

class Operator <<actor>>

package "Launch and environment configuration" {
  class "run_app.ps1 / run_app.sh" as Launcher <<script>>
  class "build_android_rust.ps1 / .sh" as AndroidRustBuild <<script>>
  class "Windows CMake Cargo target" as WindowsRustBuild <<build>>
  class "config_debug.json / config_production.json" as ConfigProfiles <<JSON>>
}

package "Flutter plugins and host APIs" {
  class "desktop_screenshot" as DesktopScreenshot <<plugin>>
  class "flutter_screen_recording" as ScreenRecording <<plugin>>
  class "video_thumbnail" as VideoThumbnail <<plugin>>
  class "path_provider" as PathProvider <<plugin>>
  class "Bonsoir mDNS" as Bonsoir <<plugin>>
  class "ADB Platform-Tools" as AdbCli <<external>>
  class "Windows / Linux / Android display" as DisplayApi <<platform>>
}

package "Rust backend crate" {
  class "C ABI" as RustFfi {
    + mlrc_watcher_start(...): i32
    + mlrc_watcher_send(...): i32
    + mlrc_watcher_poll(...): i32
    + mlrc_watcher_stop(...): void
  }
  class Watcher {
    - mode: OperationMode
    - transport: Box<dyn Transport>
    - fallback_reason: Option<String>
    + new(config): Result<Watcher, BackendError>
    + transmit(frame): Result<(), BackendError>
    + receive(): Result<Vec<u8>, BackendError>
  }
  class WatcherConfig {
    + mode: OperationMode
    + communication: CommPreference
    + usb: Option<UsbConfig>
    + wifi: Option<UdpConfig>
  }
  interface Transport {
    + communication_type(): CommType
    + send(frame): Result<(), BackendError>
    + receive(): Result<Vec<u8>, BackendError>
  }
  class UdpTransport {
    - socket: UdpSocket
    - incomplete: frame assemblies
    - ready: jitter buffer
  }
  class UsbBulkTransport <<usb feature>> {
    - handle: libusb DeviceHandle
    - endpoints: IN / OUT
  }
  class UdpConfig
  class UsbConfig
  enum OperationMode {
    Transmit
    Receive
  }
  enum CommPreference {
    Auto
    Usb
    Wifi
  }
  enum CommType {
    Usb
    Wifi
  }
  class BackendError
}

package "Remote transport peers" {
  class "mDNS peer" as MdnsPeer <<external>>
  class "TCP presence client" as PresenceClient <<external>>
  class "ADB-visible Android device" as AndroidDevice <<external>>
  class "UDP transport peer" as UdpPeer <<external>>
  class "USB bulk peer" as UsbPeer <<external>>
}

Operator --> WatcherTerminalApp
WatcherTerminalApp --> TerminalDashboard : home
TerminalDashboard *-- DashboardState
DashboardState --> RustTransport : start / send / poll / stop
DashboardState --> ScreenCaptureService : capture frame
DashboardState --> LocalPeerDiscovery : opt-in discovery
DashboardState ..> AdbDiscovery : desktop host discovery
RustTransport ..> RustFfi : Dart FFI
RustFfi --> Watcher

ScreenCaptureService ..> DesktopScreenshot : Windows / Linux capture
ScreenCaptureService ..> ScreenRecording : brief Android recording
ScreenRecording ..> DisplayApi : Android capture authorization
ScreenCaptureService ..> VideoThumbnail : extract one preview frame
ScreenCaptureService ..> PathProvider : temporary cache path

LocalPeerDiscovery *-- PresenceServer : binds TCP port
LocalPeerDiscovery ..> Bonsoir : advertise / discover\n_mlrc-accs._tcp
LocalPeerDiscovery --> DiscoveredNode : publishes resolved peers
PresenceServer --> PresenceClient : "MLRC-ACCS/1" presence line
AdbDiscovery --> AdbCli : devices -l
AdbDiscovery --> AdbDevice : parses device list
AdbCli --> AndroidDevice

Launcher --> ConfigProfiles : selects profile
Launcher --> WatcherTerminalApp : --dart-define-from-file
Launcher --> AndroidRustBuild : Android target
AndroidRustBuild --> RustFfi : armeabi-v7a / arm64-v8a / x86_64 .so
WindowsRustBuild --> RustFfi : Windows DLL

WatcherConfig ..> Watcher : constructor input
Watcher *-- Transport : selects one transport
UdpTransport ..|> Transport
UsbBulkTransport ..|> Transport
UdpTransport *-- UdpConfig
UsbBulkTransport ..> UsbConfig : configured at open
Watcher ..> OperationMode
Watcher ..> CommPreference
Transport ..> CommType
Transport ..> BackendError
UdpTransport --> UdpPeer : UDP frame chunks
UsbBulkTransport --> UsbPeer : length-prefixed bulk frames

note right of DashboardState
  Transmit captures and sends one still frame per
  start or explicit debug capture. Receive displays
  the latest received frame; no live video pipeline.
end note

note bottom of LocalPeerDiscovery
  The advertised port is also bound by the local Rust
  UDP transport. Discovered IPv4 address and service
  port configure the remote UDP peer.
end note

note bottom of Watcher
  The C ABI worker owns the Watcher and exposes a
  bounded outgoing queue plus a polled incoming queue.
end note

note right of UdpTransport
  12-byte MAC1 / sequence / chunk-index / chunk-count
  header; bounded reassembly and jitter buffer.
  Best-effort UDP; no retransmission.
end note

note right of UsbBulkTransport
  Optional Cargo feature "usb". Uses configured device
  IDs, interface and endpoints; no peer firmware or
  device/endpoint discovery is included.
end note
@enduml
